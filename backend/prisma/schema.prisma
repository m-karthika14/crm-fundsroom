// Prisma schema for fundsroom-crm
// Models follow the project master plan; comments kept plain and friendly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The 4 roles a user can have. Using a real enum (instead of a plain
// string) means Postgres itself rejects any typo'd or unknown role.
enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
}

// A customer is one of three business types.
enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

// Where a customer is in the sales pipeline. No strict state machine --
// any status can move to any other status (see Part D of the plan).
enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

model Customer {
  id         String        @id @default(uuid())
  name       String
  // Enforced unique at the DB level: two customer records sharing a
  // mobile number is almost always a duplicate/data-entry mistake, and
  // a clean 409 on creation is more useful than silently allowing it.
  mobile     String        @unique
  email      String?
  businessName String?
  gstNumber  String?
  type       CustomerType
  address    String
  status     CustomerStatus @default(LEAD)
  followUpDate DateTime?
  createdAt  DateTime    @default(now())
  notes      CustomerNote[]
  challans   Challan[]
}

model CustomerNote {
  id         String   @id @default(uuid())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  note       String
  createdBy  String
  createdAt  DateTime @default(now())
}

model Product {
  id            String         @id @default(uuid())
  name          String
  sku           String         @unique
  category      String
  unitPrice     Decimal
  currentStock  Int            @default(0)
  minStockAlert Int            @default(0)
  location      String?
  imageUrl      String?
  createdAt     DateTime       @default(now())
  movements     StockMovement[]
}

// IN = stock coming in (restock), OUT = stock going out (sold/used).
enum StockMovementType {
  IN
  OUT
}

model StockMovement {
  id              String            @id @default(uuid())
  product         Product           @relation(fields: [productId], references: [id])
  productId       String
  quantityChanged Int
  type            StockMovementType
  reason          String
  createdBy       String
  createdAt       DateTime          @default(now())
}

model Challan {
  id            String        @id @default(uuid())
  challanNumber String        @unique
  customer      Customer      @relation(fields: [customerId], references: [id])
  customerId    String
  totalQuantity Int
  status        String        @default("DRAFT")
  createdBy     String
  createdAt     DateTime      @default(now())
  items         ChallanItem[]
}

model ChallanItem {
  id                String   @id @default(uuid())
  challan           Challan  @relation(fields: [challanId], references: [id])
  challanId         String
  productId         String
  productNameSnapshot String
  productSkuSnapshot  String
  unitPriceSnapshot  Decimal
  quantity          Int
}
