DATABASE_URL="postgresql://user:pass@host:5432/dbname"
JWT_SECRET="replace_with_secure_random"
PORT=4000
# The deployed frontend's URL, so CORS allows its requests. Defaults to
# the Vite dev server's port if unset.
FRONTEND_URL="http://localhost:5173"
# Optional AWS S3 (bonus)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
